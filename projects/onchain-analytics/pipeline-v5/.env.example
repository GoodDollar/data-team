# Required
ENVIO_API_TOKEN=your-envio-hypersync-api-token

# Optional, with defaults
# GCP_PROJECT_ID=gooddollar
# DATASET_ID=BlockchainEvents
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# LOG_FILE=pipeline.log
# CHUNK_SIZE_TARGET=50000
# BQ_RETRIES=5
# HYPERSYNC_RETRIES=5
# FRESHNESS_THRESHOLD_HOURS=36

# Fetch sizing. A chunk is one HyperSync request and one unit of accounting. It either
# completed, or it is named in the run's skip list.
# XDC_CHUNK_BLOCKS=20000
# CELO_CHUNK_BLOCKS=20000

# Largest block span each chain's public RPC endpoints accept for eth_getLogs. Used only when
# confirming that a range really is empty. A range-too-large error renders as nothing found
# unless errors are counted separately from results, so these are set below the known caps.
# XDC_RPC_LOG_RANGE=1000
# CELO_RPC_LOG_RANGE=5000

# Deadlines. Node's fetch has no default timeout and the HyperSync client retries internally
# without bound, so a hung socket is indistinguishable from slow work. One backfill in this
# project hung indefinitely on exactly that. Each chunk runs in a child process that is killed
# at HS_CHUNK_TIMEOUT_MS, and a contract's whole range is abandoned at HS_RANGE_DEADLINE_MS
# with the unattempted blocks recorded rather than silently skipped.
# HS_CHUNK_TIMEOUT_MS=120000
# HS_RANGE_DEADLINE_MS=5400000
# RPC_TIMEOUT_MS=30000

# Pacing, applied on success as well as on failure. An unpaced wide scan draws sustained 429s.
# HS_CHUNK_PAUSE_MS=900
# RPC_PAUSE_MS=250

# A chunk that returns no logs is a NEGATIVE, not a result. When true, every empty chunk is
# confirmed against an independent JSON-RPC source before the watermark is allowed past it.
# An identical repeated log query on these endpoints returned zero seven times in ten one day
# and three times in ten the day before, with no errors raised either day.
# Setting this to false is how a false zero becomes a permanent gap.
# CONFIRM_EMPTY_CHUNKS=true

# Repetitions used by calibrate mode to measure each source's miss rate in session.
# CALIBRATION_REPEATS=10
